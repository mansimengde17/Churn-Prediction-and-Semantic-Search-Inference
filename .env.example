# ============================================================
# Application Configuration
# ============================================================
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here

# ============================================================
# PostgreSQL + pgvector (primary database)
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=churn_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/churn_db

# ============================================================
# Snowflake (data warehouse)
# ============================================================
SNOWFLAKE_ACCOUNT=your-account.us-east-1
SNOWFLAKE_USER=your-snowflake-user
SNOWFLAKE_PASSWORD=your-snowflake-password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CHURN_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=SYSADMIN

# ============================================================
# AWS / Redshift
# ============================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

REDSHIFT_HOST=your-cluster.region.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=churn_dw
REDSHIFT_USER=your-redshift-user
REDSHIFT_PASSWORD=your-redshift-password

S3_BUCKET=your-churn-model-bucket
S3_MODEL_PREFIX=models/

# ============================================================
# Model Configuration
# ============================================================
MODEL_ARTIFACT_PATH=models/artifacts/
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHURN_MODEL_FILE=churn_model_pipeline.joblib
EMBEDDING_DIM=384

# ============================================================
# Streamlit
# ============================================================
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000
